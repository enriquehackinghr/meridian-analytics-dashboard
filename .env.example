# =============================================================================
# Meridian Analytics Dashboard — Environment Variable Template
# =============================================================================
# COPY this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real secrets to this repo.
# In production (Render), set these as environment variables in the Render
# service dashboard, NOT in any committed file.
#
# Naming note: the frontend framework (Next.js vs Vite) is not yet locked
# (PRD §24 open question). Once chosen, public-safe vars will be prefixed:
#   - Next.js:  NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY
#   - Vite:     VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY
# For now we keep unprefixed names; update both files when the scaffold is set.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase — Database, Auth, and storage
# -----------------------------------------------------------------------------
# Get these from Supabase dashboard → Project Settings → API
# Project URL (safe to expose to the browser)
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon public key (safe to expose to the browser — RLS protects data)
SUPABASE_ANON_KEY=your-anon-public-key-here

# Service role key (BACKEND ONLY — bypasses RLS, NEVER expose in frontend code,
# NEVER commit, NEVER log). Used only in server-side analytics functions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Direct Postgres connection string (for migrations + server-side queries)
# Format: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Environment name: development | preview | production
APP_ENV=development

# Public base URL of the deployed app (used for auth redirects, share links)
# Local: http://localhost:3000   |   Production: https://<your-render-url>
APP_BASE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Optional — add as needed during build
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=          # Only if a v2 NL-question feature uses Claude
# SENTRY_DSN=                 # Optional error monitoring
# POSTHOG_API_KEY=            # Optional product analytics
